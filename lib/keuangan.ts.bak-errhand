import { GoogleGenAI } from '@google/genai';
import {
  insertTransaction,
  listTransactions,
  findDuplicateTransaction,
  type NewTransaction,
  type TransactionRow,
} from './db';

export interface FinanceSummary {
  totalPemasukan: number;
  totalPengeluaran: number;
  labaBersih: number;
  profitMargin: number;
  totalTransaksi: number;
}

export interface TrendPoint {
  month: string;
  pemasukan: number;
  pengeluaran: number;
}

export function computeSummary(rows: TransactionRow[]): FinanceSummary {
  const totalPemasukan = rows
    .filter((t) => t.tipe === 'Pemasukan')
    .reduce((sum, t) => sum + t.jumlah, 0);
  const totalPengeluaran = rows
    .filter((t) => t.tipe === 'Pengeluaran')
    .reduce((sum, t) => sum + t.jumlah, 0);
  const labaBersih = totalPemasukan - totalPengeluaran;
  const profitMargin = totalPemasukan > 0 ? Math.round((labaBersih / totalPemasukan) * 1000) / 10 : 0;
  return { totalPemasukan, totalPengeluaran, labaBersih, profitMargin, totalTransaksi: rows.length };
}

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

export function computeTrend(rows: TransactionRow[]): TrendPoint[] {
  const map = new Map<string, TrendPoint>();
  for (const t of rows) {
    const key = t.tanggal ? t.tanggal.substring(0, 7) : new Date().toISOString().substring(0, 7);
    let point = map.get(key);
    if (!point) {
      const [year, monthNum] = key.split('-');
      const label = `${MONTH_NAMES[parseInt(monthNum, 10) - 1] || monthNum} ${year}`;
      point = { month: label, pemasukan: 0, pengeluaran: 0 };
      map.set(key, point);
    }
    if (t.tipe === 'Pemasukan') point.pemasukan += t.jumlah;
    else point.pengeluaran += t.jumlah;
  }
  return Array.from(map.values());
}

interface ParsedChat {
  tipe: 'Pemasukan' | 'Pengeluaran';
  kategori: string;
  jumlah: number;
  keterangan: string;
  metode: string;
}

function extractJsonFromText(text: string): Record<string, any> | null {
  const cleaned = text.replace(/```json/gi, '').replace(/```/g, '').trim();
  try {
    const parsed = JSON.parse(cleaned);
    if (parsed && typeof parsed === 'object') return parsed;
  } catch {
    /* fall through */
  }
  const start = cleaned.indexOf('{');
  const end = cleaned.lastIndexOf('}');
  if (start >= 0 && end > start) {
    try {
      const parsed = JSON.parse(cleaned.slice(start, end + 1));
      if (parsed && typeof parsed === 'object') return parsed;
    } catch {
      /* fall through */
    }
  }
  return null;
}

async function geminiExtract(chatMessage: string): Promise<Record<string, any> | null> {
  if (!process.env.GEMINI_API_KEY) return null;
  try {
    const ai = new GoogleGenAI({
      apiKey: process.env.GEMINI_API_KEY,
      httpOptions: { headers: { 'User-Agent': 'aistudio-build' } },
    });
    const prompt = `Anda adalah Hermes Financial Bot Parser.
Analisis pesan chat keuangan berikut yang dikirim pengguna via WhatsApp/Telegram:
"${chatMessage}"

Ekstrak informasi transaksi dalam format JSON MURNI tanpa markdown (tanpa \`\`\`json):
{
  "tipe": "Pemasukan" atau "Pengeluaran",
  "kategori": "Kategori yang relevan (misal: Client Development, Hardware & Listrik, Internet & Networking, Ops, Konsumsi)",
  "jumlah": Angka murni (contoh: 500000, 150000),
  "keterangan": "Deskripsi singkat yang bersih",
  "metode": "Metode pembayaran jika disebutkan (BCA, Mandiri, Cash, Auto-Debit, QRIS, dll) atau default 'Transfer'"
}`;
    const response = await ai.models.generateContent({
      model: 'gemini-2.5-flash',
      contents: prompt,
    });
    const rawText = (response.text as string | undefined)?.trim() || '';
    return rawText ? extractJsonFromText(rawText) : null;
  } catch (e) {
    console.warn('Gemini AI parsing failed, using rule-based fallback:', e);
    return null;
  }
}

function ruleBasedExtract(chatMessage: string): ParsedChat {
  const msgLower = chatMessage.toLowerCase();
  const isPengeluaran =
    msgLower.includes('beli') ||
    msgLower.includes('bayar') ||
    msgLower.includes('keluar') ||
    msgLower.includes('pengeluaran') ||
    msgLower.includes('sewa') ||
    msgLower.includes('tagihan');

  const digits = chatMessage.match(/\d[\d\.\,kKrbRBjtJt]*/g);
  let amount = 150000;
  if (digits && digits.length > 0) {
    let numStr = digits[0].replace(/\./g, '').replace(/,/g, '');
    const suffix = numStr.slice(-2).toLowerCase();
    if (suffix === 'jt') amount = parseFloat(numStr) * 1000000;
    else if (suffix === 'rb') amount = parseFloat(numStr) * 1000;
    else if (suffix.endsWith('k')) amount = parseFloat(numStr) * 1000;
    else amount = parseFloat(numStr) || 150000;
  }

  let metode = 'Transfer';
  if (msgLower.includes('cash') || msgLower.includes('tunai')) metode = 'Cash / Tunai';
  if (msgLower.includes('qris')) metode = 'QRIS';
  if (msgLower.includes('mandiri')) metode = 'Bank Mandiri';
  if (msgLower.includes('bca')) metode = 'BCA';

  let kategori = isPengeluaran ? 'Operasional Server & Hardware' : 'Client Services';
  if (msgLower.includes('listrik') || msgLower.includes('pln') || msgLower.includes('ups')) kategori = 'Hardware & Listrik';
  if (msgLower.includes('internet') || msgLower.includes('indihome')) kategori = 'Internet & Networking';

  return {
    tipe: isPengeluaran ? 'Pengeluaran' : 'Pemasukan',
    kategori,
    jumlah: amount,
    keterangan: chatMessage,
    metode,
  };
}

export interface InsertResult {
  duplicate: boolean;
  transaction: TransactionRow;
  matchedId?: string;
}

export async function parseChatAndInsert(
  chatMessage: string,
  source: string,
  extra?: { tanggal?: string; refId?: string }
): Promise<InsertResult> {
  let parsed: Record<string, any> | null = await geminiExtract(chatMessage);
  if (!parsed || parsed.jumlah == null) parsed = ruleBasedExtract(chatMessage) as unknown as Record<string, any>;

  const tx: NewTransaction = {
    tanggal: extra?.tanggal || new Date().toISOString().split('T')[0],
    tipe: parsed.tipe === 'Pengeluaran' ? 'Pengeluaran' : 'Pemasukan',
    kategori: String(parsed.kategori || 'Umum'),
    jumlah: Number(parsed.jumlah) || 0,
    keterangan: String(parsed.keterangan || chatMessage),
    metode: String(parsed.metode || 'Transfer'),
    source: source || 'WhatsApp Auto-Bot',
    ref_id: extra?.refId || undefined,
  };

  // Dedup: serial/invoice sama ATAU (tanggal+jumlah+keterangan) identik → tolak insert
  const dup = findDuplicateTransaction(tx);
  if (dup) return { duplicate: true, transaction: dup, matchedId: dup.id };

  const inserted = insertTransaction(tx);
  return { duplicate: false, transaction: inserted };
}

export function buildBotConfirmation(tx: TransactionRow): string {
  return `🤖 *Hermes Auto-Transaction Detected!*
- *Tipe*: ${tx.tipe}
- *Kategori*: ${tx.kategori}
- *Jumlah*: Rp ${tx.jumlah.toLocaleString('id-ID')}
- *Keterangan*: ${tx.keterangan}
- *Metode*: ${tx.metode}
- *Database*: SQLite WAL (HDD Saved)

_Pesan otomatis dicatat dari ${tx.source} via 9Router Gateway._`;
}

export async function generateFinanceReport(): Promise<{ summary: FinanceSummary; analysisReport: string }> {
  const rows = listTransactions();
  const summary = computeSummary(rows);
  let analysisReport = '';

  if (process.env.GEMINI_API_KEY) {
    try {
      const ai = new GoogleGenAI({
        apiKey: process.env.GEMINI_API_KEY,
        httpOptions: { headers: { 'User-Agent': 'aistudio-build' } },
      });
      const prompt = `Anda adalah Hermes Financial AI Analyst di server apu.web.id.
Lakukan Analisa Mandiri & Laporan Eksekutif dari data transaksi SQLite WAL berikut:
- Total Pemasukan: Rp ${summary.totalPemasukan}
- Total Pengeluaran: Rp ${summary.totalPengeluaran}
- Laba Bersih: Rp ${summary.labaBersih}
- Margin Keuntungan: ${summary.profitMargin}%
- Daftar Transaksi Terakhir: ${JSON.stringify(rows.slice(0, 8))}

Berikan laporan terstruktur dalam Bahasa Indonesia:
1. **Status Kesehatan Finansial** (Berikan skor x/100 dan status cash flow).
2. **Analisis Pengeluaran Dominan** (Komponen mana yang makan biaya terbanyak).
3. **Peluang Efisiensi & Rekomendasi** (3 tindakan nyata untuk efisiensi server/operasional).
4. **Proyeksi Bulan Depan** (Estimasi pertumbuhan laba).`;
      const response = await ai.models.generateContent({
        model: 'gemini-2.5-flash',
        contents: prompt,
      });
      analysisReport = (response.text as string | undefined) || '';
    } catch (e) {
      console.warn('Gemini report analysis failed, fallback to local rule report:', e);
    }
  }

  if (!analysisReport) {
    const dominant = [...rows]
      .filter((t) => t.tipe === 'Pengeluaran')
      .sort((a, b) => b.jumlah - a.jumlah)[0];
    analysisReport = `📊 **ANALISA MANDIRI HERMES AI (INDEPENDENT REPORT)**:

1. **Skor Kesehatan Finansial**: ${summary.totalTransaksi === 0 ? 'Belum ada data' : summary.profitMargin >= 0 ? `${Math.min(95, Math.max(50, Math.round(50 + summary.profitMargin)))}/100` : '< 50/100'} (${summary.labaBersih >= 0 ? 'Cash flow positif' : 'Cash flow negatif'}).
2. **Analisis Pengeluaran Dominan**: ${dominant ? `Terbesar di **${dominant.kategori}** sebesar Rp ${dominant.jumlah.toLocaleString('id-ID')}.` : 'Belum ada data pengeluaran.'}
3. **Rekomendasi Hermes Agent**: Catat transaksi rutin via bot, tinjau kategori pengeluaran terbesar, dan alokasikan sebagian laba bersih ke cadangan perawatan.
4. **Proyeksi Finansial Bulan Depan**: Berdasarkan data riil saat ini — ${summary.totalTransaksi === 0 ? 'tambahkan transaksi untuk estimasi akurat.' : `margin ${summary.profitMargin}% dengan ${summary.totalTransaksi} transaksi tercatat.`}`;
  }

  return { summary, analysisReport };
}
